{
  "$schema": "https://raw.githubusercontent.com/ThreeMammals/Ocelot/main/src/Ocelot/Configuration/ocelot.schema.json",
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/email/send",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        },
        {
          "Host": "localhost",
          "Port": 5002
        }
      ],
      "UpstreamPathTemplate": "/email/send",
      "UpstreamHttpMethod": [ "POST" ],
      "Key": "send-email",
      "Priority": 1,
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1m",
        "PeriodTimespan": 60,
        "Limit": 100
      },
      "QoSOptions": {
        "ExceptionsAllowedBeforeBreaking": 3,
        "DurationOfBreak": 10000,
        "TimeoutValue": 30000
      },
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "ApiKey"
      }
    },
    {
      "DownstreamPathTemplate": "/api/email/send/template",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        },
        {
          "Host": "localhost",
          "Port": 5002
        }
      ],
      "UpstreamPathTemplate": "/email/send/template",
      "UpstreamHttpMethod": [ "POST" ],
      "Key": "send-template-email",
      "Priority": 1,
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Period": "1m",
        "PeriodTimespan": 60,
        "Limit": 50
      },
      "QoSOptions": {
        "ExceptionsAllowedBeforeBreaking": 3,
        "DurationOfBreak": 10000,
        "TimeoutValue": 45000
      },
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      }
    },
    {
      "DownstreamPathTemplate": "/api/email/send/bulk",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        }
      ],
      "UpstreamPathTemplate": "/email/send/bulk",
      "UpstreamHttpMethod": [ "POST" ],
      "Key": "send-bulk-email",
      "Priority": 1,
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Period": "10m",
        "PeriodTimespan": 600,
        "Limit": 5
      },
      "QoSOptions": {
        "ExceptionsAllowedBeforeBreaking": 2,
        "DurationOfBreak": 20000,
        "TimeoutValue": 120000
      }
    },
    {
      "DownstreamPathTemplate": "/api/email/status/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        },
        {
          "Host": "localhost",
          "Port": 5002
        }
      ],
      "UpstreamPathTemplate": "/email/status/{id}",
      "UpstreamHttpMethod": [ "GET" ],
      "Key": "email-status",
      "Priority": 1,
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Period": "1m",
        "PeriodTimespan": 60,
        "Limit": 300
      },
      "FileCacheOptions": {
        "TtlSeconds": 15,
        "Region": "email-status-cache"
      },
      "LoadBalancerOptions": {
        "Type": "LeastConnection"
      }
    },
    {
      "DownstreamPathTemplate": "/health",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        }
      ],
      "UpstreamPathTemplate": "/health/api",
      "UpstreamHttpMethod": [ "GET" ],
      "Key": "api-health-check",
      "Priority": 1,
      "FileCacheOptions": {
        "TtlSeconds": 5,
        "Region": "health-cache"
      }
    },
    {
      "DownstreamPathTemplate": "/api/health/detailed",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        }
      ],
      "UpstreamPathTemplate": "/health/api/detailed",
      "UpstreamHttpMethod": [ "GET" ],
      "Key": "api-health-detailed",
      "Priority": 1
    },
    {
      "DownstreamPathTemplate": "/swagger/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        }
      ],
      "UpstreamPathTemplate": "/docs/{everything}",
      "UpstreamHttpMethod": [ "GET" ],
      "Key": "api-documentation",
      "Priority": 1
    },
    {
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ],
      "UpstreamPathTemplate": "/admin/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "Key": "admin-dashboard",
      "Priority": 2
    }
  ],
  "Aggregates": [
    {
      "RouteKeys": [
        "api-health-check"
      ],
      "UpstreamPathTemplate": "/health/all",
      "UpstreamHttpMethod": [ "GET" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8080",
    "RateLimitOptions": {
      "DisableRateLimitHeaders": false,
      "QuotaExceededMessage": "API rate limit exceeded. Please wait {0} seconds before retrying.",
      "HttpStatusCode": 429,
      "ClientIdHeader": "X-Client-Id"
    },
    "QoSOptions": {
      "ExceptionsAllowedBeforeBreaking": 3,
      "DurationOfBreak": 10000,
      "TimeoutValue": 30000
    },
    "LoadBalancerOptions": {
      "Type": "LeastConnection",
      "Key": "EmailServiceInstances",
      "Expiry": 300000
    },
    "HttpHandlerOptions": {
      "AllowAutoRedirect": false,
      "UseCookieContainer": false,
      "UseTracing": true,
      "UseProxy": false
    },
    "DownstreamHttpVersion": "1.1"
  }
}
