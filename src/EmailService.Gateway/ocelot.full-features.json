{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/email/send",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        }
      ],
      "UpstreamPathTemplate": "/email/send",
      "UpstreamHttpMethod": [ "POST" ],
      "Key": "send-email",
      "Priority": 1,
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1m",
        "PeriodTimespan": 60,
        "Limit": 100
      },
      "QoSOptions": {
        "ExceptionsAllowedBeforeBreaking": 3,
        "DurationOfBreak": 10000,
        "TimeoutValue": 30000
      }
    },
    {
      "DownstreamPathTemplate": "/api/email/send/template",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        }
      ],
      "UpstreamPathTemplate": "/email/send/template",
      "UpstreamHttpMethod": [ "POST" ],
      "Key": "send-template-email",
      "Priority": 1,
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1m",
        "PeriodTimespan": 60,
        "Limit": 50
      },
      "QoSOptions": {
        "ExceptionsAllowedBeforeBreaking": 3,
        "DurationOfBreak": 10000,
        "TimeoutValue": 45000
      }
    },
    {
      "DownstreamPathTemplate": "/api/email/send/bulk",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        }
      ],
      "UpstreamPathTemplate": "/email/send/bulk",
      "UpstreamHttpMethod": [ "POST" ],
      "Key": "send-bulk-email",
      "Priority": 1,
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "10m",
        "PeriodTimespan": 600,
        "Limit": 5
      },
      "QoSOptions": {
        "ExceptionsAllowedBeforeBreaking": 2,
        "DurationOfBreak": 20000,
        "TimeoutValue": 120000
      }
    },
    {
      "DownstreamPathTemplate": "/api/email/status/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        }
      ],
      "UpstreamPathTemplate": "/email/status/{id}",
      "UpstreamHttpMethod": [ "GET" ],
      "Key": "email-status",
      "Priority": 1,
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1m",
        "PeriodTimespan": 60,
        "Limit": 300
      },
      "FileCacheOptions": {
        "TtlSeconds": 15,
        "Region": "email-status"
      }
    },
    {
      "DownstreamPathTemplate": "/api/email/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        }
      ],
      "UpstreamPathTemplate": "/email/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "Key": "email-catchall",
      "Priority": 100,
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1m",
        "PeriodTimespan": 60,
        "Limit": 200
      }
    },
    {
      "DownstreamPathTemplate": "/health",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        }
      ],
      "UpstreamPathTemplate": "/health/api",
      "UpstreamHttpMethod": [ "GET" ],
      "Key": "api-health",
      "FileCacheOptions": {
        "TtlSeconds": 5,
        "Region": "health"
      }
    },
    {
      "DownstreamPathTemplate": "/api/health/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        }
      ],
      "UpstreamPathTemplate": "/health/{everything}",
      "UpstreamHttpMethod": [ "GET" ],
      "Key": "health-detailed"
    },
    {
      "DownstreamPathTemplate": "/swagger/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5000
        }
      ],
      "UpstreamPathTemplate": "/docs/{everything}",
      "UpstreamHttpMethod": [ "GET" ],
      "Key": "swagger-docs"
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8080",
    "RateLimitOptions": {
      "DisableRateLimitHeaders": false,
      "QuotaExceededMessage": "Rate limit exceeded. Please retry after {0} seconds.",
      "HttpStatusCode": 429,
      "ClientIdHeader": "X-Client-Id"
    }
  }
}
